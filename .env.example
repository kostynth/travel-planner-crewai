# =========================================================
#  LLM 配置 / 智谱 GLM 大模型配置
#  使用智谱 AI 云端 API, 默认模型 glm-4.7-flash (免费额度)
# =========================================================

# --- 提供方 (litellm 路由前缀, 智谱为 zai) ---
LLM_PROVIDER=zai

# --- 模型名 ---
# 免费额度模型: glm-4.7-flash / glm-4.6v-flash / glm-4.5-flash
# 若需付费旗舰模型, 改为 glm-4.7 / glm-5.2 等
LLM_MODEL=zai/glm-4.7-flash

# --- 服务地址 (国内版与国际版 API Key 不互通) ---
# 国内版 (bigmodel.cn, 需手机号验证): https://open.bigmodel.cn/api/paas/v4
# 国际版 (z.ai, 邮箱注册):           https://api.z.ai/api/paas/v4
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# --- 智谱 API Key (控制台 → API Key 管理 → 创建) ---
ZHIPU_API_KEY=

# --- 采样参数 ---
LLM_TEMPERATURE=0.3
LLM_TOP_P=0.9
LLM_TIMEOUT=600
LLM_MAX_TOKENS=8192

# --- 代理最大迭代轮数 ---
MAX_ITER=25


# =========================================================
#  景点图片下载配置 (icrawler + Bing 图片搜索)
#  无需 API Key, 直接抓取 Bing 图片搜索结果
# =========================================================

# --- 图片保存根目录 ---
IMAGE_ROOT_DIR=data/images

# --- 每个景点最多下载的图片数量 ---
IMAGE_MAX_NUM_PER_PLACE=10


# =========================================================
#  外部搜索 / 地图服务 API 密钥 (可选)
#  未配置时相关工具返回空数据, 不影响主流程
# =========================================================

# --- Tavily: 语义化网页搜索 ---
TAVILY_API_KEY=

# --- 高德地图 (Amap): 中国境内 POI 与路径规划 ---
GAODE_API_KEY=

# --- SerpApi: 备选 Google 搜索 ---
SERPAPI_API_KEY=

# --- Bing Search API: 额外搜索后端 ---
BING_API_KEY=